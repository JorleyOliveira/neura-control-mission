NEURALAKE_API_KEY=replace-with-rotated-key
NEURALAKE_BASE_URL=https://api.neuralake.cloud/v1
NEURALAKE_MODEL=auto
DATABASE_PATH=/app/state/neura.db
AGENT_DATASET_DIR=/app/data/agency-agents
SAMPLE_AGENT_DATASET_DIR=/app/data/sample-agents
JARVIS_BASE_URL=http://jarvis:8000
MARCELO_BASE_URL=http://marcelo:8001
RUNNER_BASE_URL=http://runner:8002
AGENT_MAX_STEPS=16
TOOL_TIMEOUT_SECONDS=45
MAX_TASK_ATTEMPTS=2
MARKETPLACE_CANDIDATE_LIMIT=5

# Optional: A2A worker gateway auth (docker compose pre-wires demo-a2a-token)
# WORKER_GATEWAY_TOKEN=demo-a2a-token

# Optional: seller agent
# SELLER_BASE_URL=http://seller:8020

# Optional: Agora Conversational AI voice (all four + certificate enable voice)
# AGORA_APP_ID=
# AGORA_AGENT_ID=
# AGORA_CUSTOMER_ID=
# AGORA_CUSTOMER_SECRET=
# AGORA_APP_CERTIFICATE=
